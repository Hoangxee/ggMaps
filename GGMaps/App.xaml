<Application
    x:Class="GGMaps.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:GGMaps">

    <!-- RequestedTheme is set in App() from the "Theme" LocalSettings value ("light" default like Google Maps iOS, "dark", "system").
         Always reference these keys with {ThemeResource ...}. -->
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>

                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="PageBgBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="SurfaceLowBrush" Color="#F8F9FA" />
                    <SolidColorBrush x:Key="SurfaceHighBrush" Color="#F1F3F4" />
                    <SolidColorBrush x:Key="FloatingBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="FloatingEdgeBrush" Color="#33000000" />
                    <SolidColorBrush x:Key="OnSurfaceBrush" Color="#202124" />
                    <SolidColorBrush x:Key="OnSurfaceVariantBrush" Color="#5F6368" />
                    <SolidColorBrush x:Key="OutlineBrush" Color="#80868B" />
                    <SolidColorBrush x:Key="OutlineVariantBrush" Color="#DADCE0" />
                    <SolidColorBrush x:Key="DividerBrush" Color="#E8EAED" />
                    <SolidColorBrush x:Key="PrimaryBrush" Color="#1A73E8" />
                    <SolidColorBrush x:Key="OnPrimaryBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="PrimaryContainerBrush" Color="#E8F0FE" />
                    <SolidColorBrush x:Key="OnPrimaryContainerBrush" Color="#1967D2" />
                    <SolidColorBrush x:Key="ChipBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="ChipSelectedBrush" Color="#E8F0FE" />
                    <SolidColorBrush x:Key="StarBrush" Color="#FBBC04" />
                    <SolidColorBrush x:Key="PinRedBrush" Color="#EA4335" />
                    <SolidColorBrush x:Key="PinDarkRedBrush" Color="#A50E0E" />
                    <SolidColorBrush x:Key="SnackbarBgBrush" Color="#323232" />
                    <SolidColorBrush x:Key="SnackbarTextBrush" Color="#F1F1F1" />
                    <SolidColorBrush x:Key="ScrimBrush" Color="#66000000" />
                    <SolidColorBrush x:Key="HandleBrush" Color="#DADCE0" />
                    <SolidColorBrush x:Key="AttributionBrush" Color="#5F6368" />

                    <Color x:Key="PhoneAccentColor">#FF1A73E8</Color>
                    <SolidColorBrush x:Key="PhoneAccentBrush" Color="#1A73E8" />
                    <SolidColorBrush x:Key="TextSelectionHighlightColorThemeBrush" Color="#1A73E8" />
                    <SolidColorBrush x:Key="ProgressBarForegroundThemeBrush" Color="#1A73E8" />
                    <SolidColorBrush x:Key="ProgressBarIndeterminateForegroundThemeBrush" Color="#1A73E8" />
                    <SolidColorBrush x:Key="ProgressBarBackgroundThemeBrush" Color="#1A73E8" Opacity="0.16" />
                    <SolidColorBrush x:Key="TextBoxBackgroundThemeBrush" Color="Transparent" />
                    <SolidColorBrush x:Key="TextBoxFocusedBackgroundThemeBrush" Color="Transparent" />
                    <SolidColorBrush x:Key="TextBoxBorderThemeBrush" Color="Transparent" />
                    <SolidColorBrush x:Key="TextBoxForegroundThemeBrush" Color="#202124" />
                    <SolidColorBrush x:Key="TextBoxPlaceholderTextThemeBrush" Color="#5F6368" />
                    <SolidColorBrush x:Key="ToggleSwitchCurtainBackgroundThemeBrush" Color="#1A73E8" />
                </ResourceDictionary>

                <ResourceDictionary x:Key="Default">
                    <SolidColorBrush x:Key="PageBgBrush" Color="#202124" />
                    <SolidColorBrush x:Key="SurfaceBrush" Color="#202124" />
                    <SolidColorBrush x:Key="SurfaceLowBrush" Color="#28292C" />
                    <SolidColorBrush x:Key="SurfaceHighBrush" Color="#303134" />
                    <SolidColorBrush x:Key="FloatingBrush" Color="#303134" />
                    <SolidColorBrush x:Key="FloatingEdgeBrush" Color="#55000000" />
                    <SolidColorBrush x:Key="OnSurfaceBrush" Color="#E8EAED" />
                    <SolidColorBrush x:Key="OnSurfaceVariantBrush" Color="#9AA0A6" />
                    <SolidColorBrush x:Key="OutlineBrush" Color="#9AA0A6" />
                    <SolidColorBrush x:Key="OutlineVariantBrush" Color="#5F6368" />
                    <SolidColorBrush x:Key="DividerBrush" Color="#3C4043" />
                    <SolidColorBrush x:Key="PrimaryBrush" Color="#8AB4F8" />
                    <SolidColorBrush x:Key="OnPrimaryBrush" Color="#202124" />
                    <SolidColorBrush x:Key="PrimaryContainerBrush" Color="#394457" />
                    <SolidColorBrush x:Key="OnPrimaryContainerBrush" Color="#D2E3FC" />
                    <SolidColorBrush x:Key="ChipBrush" Color="#303134" />
                    <SolidColorBrush x:Key="ChipSelectedBrush" Color="#394457" />
                    <SolidColorBrush x:Key="StarBrush" Color="#FDD663" />
                    <SolidColorBrush x:Key="PinRedBrush" Color="#EA4335" />
                    <SolidColorBrush x:Key="PinDarkRedBrush" Color="#A50E0E" />
                    <SolidColorBrush x:Key="SnackbarBgBrush" Color="#E8EAED" />
                    <SolidColorBrush x:Key="SnackbarTextBrush" Color="#202124" />
                    <SolidColorBrush x:Key="ScrimBrush" Color="#99000000" />
                    <SolidColorBrush x:Key="HandleBrush" Color="#5F6368" />
                    <SolidColorBrush x:Key="AttributionBrush" Color="#BDC1C6" />

                    <Color x:Key="PhoneAccentColor">#FF8AB4F8</Color>
                    <SolidColorBrush x:Key="PhoneAccentBrush" Color="#8AB4F8" />
                    <SolidColorBrush x:Key="TextSelectionHighlightColorThemeBrush" Color="#8AB4F8" />
                    <SolidColorBrush x:Key="ProgressBarForegroundThemeBrush" Color="#8AB4F8" />
                    <SolidColorBrush x:Key="ProgressBarIndeterminateForegroundThemeBrush" Color="#8AB4F8" />
                    <SolidColorBrush x:Key="ProgressBarBackgroundThemeBrush" Color="#8AB4F8" Opacity="0.16" />
                    <SolidColorBrush x:Key="TextBoxBackgroundThemeBrush" Color="Transparent" />
                    <SolidColorBrush x:Key="TextBoxFocusedBackgroundThemeBrush" Color="Transparent" />
                    <SolidColorBrush x:Key="TextBoxBorderThemeBrush" Color="Transparent" />
                    <SolidColorBrush x:Key="TextBoxForegroundThemeBrush" Color="#E8EAED" />
                    <SolidColorBrush x:Key="TextBoxPlaceholderTextThemeBrush" Color="#9AA0A6" />
                    <SolidColorBrush x:Key="ToggleSwitchCurtainBackgroundThemeBrush" Color="#8AB4F8" />
                </ResourceDictionary>

            </ResourceDictionary.ThemeDictionaries>

            <!-- Google Sans Flex static instances (SIL OFL 1.1, Assets/Fonts/OFL.txt), families "GGT Sans" / "GGT Sans Medium" -->
            <FontFamily x:Key="AppFont">/Assets/Fonts/AppFont-Regular.ttf#GGT Sans</FontFamily>
            <FontFamily x:Key="AppFontMedium">/Assets/Fonts/AppFont-Medium.ttf#GGT Sans Medium</FontFamily>
            <FontFamily x:Key="ContentFont">/Assets/Fonts/AppFont-Regular.ttf#GGT Sans, Segoe WP</FontFamily>
        </ResourceDictionary>
    </Application.Resources>
</Application>
